# Names only. Add each one here in the PR that first reads it.

# Music Nerd's Postgres (Supabase), shared with MusicNerdWeb. Staging for previews.
SUPABASE_DB_CONNECTION=
# Supabase Storage, for retained Instagram thumbnails.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Apify, for Instagram/TikTok/X social research and selected reel transcripts.
APIFY_API_TOKEN=
# The scheduler's secret. When set, GET /api/research/advance requires `Authorization: Bearer <secret>`.
CRON_SECRET=
# Vercel AI Gateway, for the caption reader and the Lore rebuild (Gemini). On Vercel the
# deployment's OIDC token is used when this is unset; set it locally. `pnpm eval:local` runs
# an eval suite from this file through the gateway, exactly as the hosted Evals workflow does
# (docs/chat-eval-pdf-evidence.md); it also needs the staging SUPABASE_DB_CONNECTION,
# SUPABASE_URL, MUSICNERD_RESEARCH_API_KEY and TAVILY_API_KEY below.
AI_GATEWAY_API_KEY=
# Eval logs show an unexpected error's name only; set to 1 to add its message (never a database query). Default unset.
EVAL_DEBUG_ERRORS=
# Artist chat retrieval: `units` searches and reads documents page by page (searchPassages,
# readUnits, listDocuments); `legacy`, or unset, keeps whole stored sources and the PDF tools.
CHAT_RETRIEVAL=legacy
# Spotify client credentials, for the verified catalog in the Lore rebuild.
SPOTIFY_WEB_CLIENT_ID=
SPOTIFY_WEB_CLIENT_SECRET=
# Tavily web search, for source_search. Unset, a queued search fails rather than filing no sources.
TAVILY_API_KEY=
# Privy (same app as MusicNerdWeb), to verify the access token signed-in routes receive as `Authorization: Bearer`.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Server-to-server public evidence research, and the secret behind the visitor question
# allowance key (getQuestionVisitorKey fails closed without it). At least 32 random characters.
# Share only with trusted Web/agent servers; never a NEXT_PUBLIC/browser variable.
MUSICNERD_RESEARCH_API_KEY=
# Discord webhook the team is notified on when a claimant adds a link (as MusicNerdWeb). Unset, nothing is sent.
DISCORD_WEBHOOK_URL=
