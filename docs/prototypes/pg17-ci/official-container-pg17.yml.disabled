# PREPARATION ONLY. Keep outside .github/workflows and keep false guard until approved.
# Pin reviewed action SHAs and postgres image digest before publication/dispatch.
name: Proposed official-container synthetic About PG17 check
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  native-pg17:
    if: ${{ false }}
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    container:
      image: postgres:17-bookworm
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: 24
      - uses: pnpm/action-setup@v4
        with:
          version: 10.9.0
          run_install: false
      - name: Install pinned test dependencies without lifecycle scripts
        run: pnpm install --frozen-lockfile --ignore-scripts
      - name: Run socket-only synthetic database as the container's unprivileged user
        run: |
          set -euo pipefail
          case "$GITHUB_WORKSPACE" in /__w/*) ;; *) echo 'Unexpected ephemeral workspace' >&2; exit 1;; esac
          workspace=$(cd -- "$GITHUB_WORKSPACE" && pwd -P)
          test "$workspace" = "$GITHUB_WORKSPACE"
          test "$(pwd -P)" = "$workspace"
          test -x /usr/local/bin/gosu
          node_executable=$(command -v node)
          test -x "$node_executable"
          chown -hR postgres:postgres "$workspace"
          /usr/local/bin/gosu postgres env -i \
            PATH="$PATH" NODE24_BIN="$node_executable" \
            PG17_BIN=/usr/lib/postgresql/17/bin MN_APPROVED_SYNTHETIC_PG17=yes \
            bash docs/prototypes/pg17-ci/run-native-pg17.sh
